node_modules/
reports/.progress/
*.log
.DS_Store

# volatile session handoff (see /prep)
WORK-STATE.md

# Reference sheet plans emitted by `npm run generate -- --emit-plan`.
# These are the Swift fidelity gate's input, regenerated by `make gate` in app/.
# Not tracked: they are ~4MB each and derive deterministically from a pinned
# snapshot plus committed code, so the inputs are the thing worth versioning.
reports/*.plan.json

# Downloaded card art for proxy printing.
# Binary, large, and re-fetchable from the URLs in each snapshot's art.json —
# the index is the thing worth versioning, not the pictures it points at.
data/art-cache/
