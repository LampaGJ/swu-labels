<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  NOT sandboxed, deliberately.

	  Two reasons. The bundle ships a command-line tool at
	  Contents/MacOS/swu-labels that must read and write paths the person
	  running it chooses; a sandboxed CLI can reach almost none of them. And
	  this is a Developer ID app, not an App Store submission, so the sandbox
	  buys no distribution requirement here.

	  The hardened runtime still applies at `make dist`. If this ever targets
	  the App Store, the CLI has to leave the bundle first.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
</dict>
</plist>
